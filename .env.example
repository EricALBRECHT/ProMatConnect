# Identifiants de démonstration locale uniquement. Aucun accès fournisseur.
POSTGRES_DB=promatconnect
POSTGRES_USER=promatconnect
POSTGRES_PASSWORD=local_demo_only
APP_PORT=8000
USER_LATITUDE=48.8566
USER_LONGITUDE=2.3522
SEED_ON_START=true
# Hors Docker, décommenter et adapter :
# DATABASE_URL=postgresql+psycopg://promatconnect:local_demo_only@localhost:5432/promatconnect

# MVP 0.2 : adresses fictives reconnues par le géocodeur de démonstration.
SITE_ADDRESS="10 rue du Chantier, 75004 Paris"
COMPANY_ADDRESS="20 rue de l'Entreprise, 75011 Paris"
COMPANY_LATITUDE=48.8600
COMPANY_LONGITUDE=2.3800
# Indicateurs de comparaison uniquement, jamais des montants facturés.
COST_PER_KM=0.50
TIME_VALUE_PER_HOUR=30.00
EXTRA_STOP_COST=5.00
OPTIMIZER_MAX_AGENCIES=8
